terraform {
  required_version = ">= 1.9.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    azuread = {
      source  = "hashicorp/azuread"
      version = "~> 3.0"
    }
  }

  # Intentionally NO backend block: bootstrap uses local state (it creates the remote state account).
  # See docs/runbooks/bootstrap.md.
}
