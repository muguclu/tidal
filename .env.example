# Tidal local environment. Copy to .env (git-ignored):  cp .env.example .env
# LOCAL EMULATORS ONLY. Every value below is either a placeholder or a PUBLIC well-known dev
# value published by Microsoft for Azurite / the Service Bus emulator; none is a real secret.
# Keys mirror docs/contracts/config-contract.md. Outside TIDAL_ENV=local these must stay unset.
# Host-side values (127.0.0.1); docker-compose.yml overrides the endpoints for the `api`
# container (azurite / sqlserver / servicebus service names).

# Required (config-contract v1.1): no default, startup fails if unset. Never `local` in Azure.
TIDAL_ENV=local
TIDAL_LOG_LEVEL=INFO
TIDAL_SERVICE_NAME=api

# Auth is bypassed locally (startup asserts TIDAL_ENV=local when true). Mint tokens with
# scripts/dev-token.py when testing the real JWT path.
TIDAL_AUTH__DISABLED=true
TIDAL_AUTH__AUDIENCE=api://tidal
# To exercise the real JWT path set TIDAL_AUTH__DISABLED=false and uncomment the block below, then
# run `uv run python scripts/dev-token.py --role Tidal.Reader` (user token for the API) or
# `... --app --audience api://tidal-query` (app token for a local tidal-query, service_name=query).
# The GUIDs are the fixed dev identities in tests/fakes/jwks/core.py (public, local only).
# TIDAL_AUTH__TENANT_ID=11111111-2222-3333-4444-555555555555
# TIDAL_AUTH__JWKS_URL=.data/dev-jwks/jwks.json
# TIDAL_AUTH__ALLOWED_CLIENT_IDS=dddddddd-0000-4000-8000-0000000000c1
# TIDAL_AUTH__QUERY_CALLER_CLIENT_IDS=dddddddd-0000-4000-8000-0000000000a1
# TIDAL_AUTH__QUERY_CALLER_OBJECT_IDS=dddddddd-0000-4000-8000-0000000000a2
TIDAL_QUERY__BASE_URL=http://query:8000
TIDAL_QUERY__AUDIENCE=api://tidal-query

# Blob: Azurite. The account key is Microsoft's public, documented devstoreaccount1 key.
TIDAL_STORAGE__ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
TIDAL_STORAGE__USE_MANAGED_IDENTITY=false
TIDAL_STORAGE__CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;" # gitleaks:allow (public Azurite dev key)

# SQL Server 2022 container (also backs the Service Bus emulator). The sa password is read by
# compose and by the app. The placeholder meets SQL Server complexity (>= 8 chars, 3 of 4 classes)
# but is public and fake: replace it with your own value. Never commit the real .env.
TIDAL_SQL__SERVER=127.0.0.1
TIDAL_SQL__DATABASE=tidal
TIDAL_SQL__AUTH=sql_password
TIDAL_SQL__USER=sa
TIDAL_SQL__PASSWORD=Local-Only-Change-Me-1  # fake; CHANGE THIS in your own .env

# Service Bus emulator. SAS_KEY_VALUE is the literal static key the emulator documents.
TIDAL_SERVICEBUS__FQDN=localhost
TIDAL_SERVICEBUS__CONNECTION_STRING="Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"

# Data / determinism
TIDAL_HOT_WINDOW_DAYS=90
TIDAL_SYNTH__SCALE=S
TIDAL_SYNTH__SEED=20261021
TIDAL_SYNTH__START=2005-01-01
TIDAL_SYNTH__END=2025-12-31

# Optional (leave unset unless needed):
# TIDAL_CLOCK__NOW=2025-12-31T00:00:00Z      # freeze "now" for hot-window demos
# TIDAL_OTEL__CONNECTION_STRING=
