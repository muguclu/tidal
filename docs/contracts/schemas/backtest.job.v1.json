{
  "$defs": {
    "BacktestCosts": {
      "additionalProperties": false,
      "description": "Transaction costs applied to traded notional.",
      "properties": {
        "fee_bps": {
          "minimum": 0,
          "title": "Fee Bps",
          "type": "number"
        },
        "slippage_bps": {
          "minimum": 0,
          "title": "Slippage Bps",
          "type": "number"
        }
      },
      "required": [
        "fee_bps",
        "slippage_bps"
      ],
      "title": "BacktestCosts",
      "type": "object"
    },
    "BacktestJob": {
      "additionalProperties": false,
      "description": "``backtest.job/v1`` payload: one (child) backtest with resolved params.",
      "properties": {
        "child_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Child Index"
        },
        "job_id": {
          "pattern": "^bt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Job Id",
          "type": "string"
        },
        "output_prefix": {
          "pattern": "^backtests/bt_[0-7][0-9A-HJKMNP-TV-Z]{25}/(child-[0-9]{4}/)?$",
          "title": "Output Prefix",
          "type": "string"
        },
        "parent_job_id": {
          "anyOf": [
            {
              "pattern": "^bt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Job Id"
        },
        "request": {
          "discriminator": {
            "mapping": {
              "calendar_spread": "#/$defs/CalendarSpreadRequest",
              "ma_crossover": "#/$defs/MaCrossoverRequest",
              "mean_reversion": "#/$defs/MeanReversionRequest"
            },
            "propertyName": "strategy"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/MaCrossoverRequest"
            },
            {
              "$ref": "#/$defs/MeanReversionRequest"
            },
            {
              "$ref": "#/$defs/CalendarSpreadRequest"
            }
          ],
          "title": "Request"
        }
      },
      "required": [
        "job_id",
        "request",
        "output_prefix"
      ],
      "title": "BacktestJob",
      "type": "object"
    },
    "CalendarSpreadRequest": {
      "additionalProperties": false,
      "description": "``calendar_spread`` on ``instrument_ids[0] - instrument_ids[1]`` (e.g. WTI FUT1 - FUT2).",
      "properties": {
        "costs": {
          "$ref": "#/$defs/BacktestCosts"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "title": "End"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 64,
            "pattern": "^[A-Z0-9]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Instrument Ids",
          "type": "array"
        },
        "interval": {
          "enum": [
            "1m",
            "1h",
            "1d"
          ],
          "title": "Interval",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/MeanReversionParams"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "title": "Start"
        },
        "strategy": {
          "const": "calendar_spread",
          "title": "Strategy",
          "type": "string"
        },
        "sweep": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "number"
                },
                "maxItems": 200,
                "minItems": 1,
                "type": "array"
              },
              "maxProperties": 3,
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sweep"
        }
      },
      "required": [
        "params",
        "interval",
        "start",
        "end",
        "costs",
        "seed",
        "strategy",
        "instrument_ids"
      ],
      "title": "CalendarSpreadRequest",
      "type": "object"
    },
    "MaCrossoverParams": {
      "additionalProperties": false,
      "description": "``ma_crossover`` parameters (SPEC-05 §2).",
      "properties": {
        "fast": {
          "minimum": 1,
          "title": "Fast",
          "type": "integer"
        },
        "slow": {
          "minimum": 1,
          "title": "Slow",
          "type": "integer"
        }
      },
      "required": [
        "fast",
        "slow"
      ],
      "title": "MaCrossoverParams",
      "type": "object"
    },
    "MaCrossoverRequest": {
      "additionalProperties": false,
      "description": "``ma_crossover`` on one instrument.",
      "properties": {
        "costs": {
          "$ref": "#/$defs/BacktestCosts"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "title": "End"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 64,
            "pattern": "^[A-Z0-9]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+$",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "interval": {
          "enum": [
            "1m",
            "1h",
            "1d"
          ],
          "title": "Interval",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/MaCrossoverParams"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "title": "Start"
        },
        "strategy": {
          "const": "ma_crossover",
          "title": "Strategy",
          "type": "string"
        },
        "sweep": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "number"
                },
                "maxItems": 200,
                "minItems": 1,
                "type": "array"
              },
              "maxProperties": 3,
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sweep"
        }
      },
      "required": [
        "params",
        "interval",
        "start",
        "end",
        "costs",
        "seed",
        "strategy",
        "instrument_ids"
      ],
      "title": "MaCrossoverRequest",
      "type": "object"
    },
    "MeanReversionParams": {
      "additionalProperties": false,
      "description": "``mean_reversion`` / ``calendar_spread`` parameters (SPEC-05 §2).",
      "properties": {
        "lookback": {
          "minimum": 2,
          "title": "Lookback",
          "type": "integer"
        },
        "z_entry": {
          "exclusiveMinimum": 0,
          "title": "Z Entry",
          "type": "number"
        },
        "z_exit": {
          "minimum": 0,
          "title": "Z Exit",
          "type": "number"
        }
      },
      "required": [
        "lookback",
        "z_entry",
        "z_exit"
      ],
      "title": "MeanReversionParams",
      "type": "object"
    },
    "MeanReversionRequest": {
      "additionalProperties": false,
      "description": "``mean_reversion`` on one instrument.",
      "properties": {
        "costs": {
          "$ref": "#/$defs/BacktestCosts"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "title": "End"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 64,
            "pattern": "^[A-Z0-9]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+$",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "interval": {
          "enum": [
            "1m",
            "1h",
            "1d"
          ],
          "title": "Interval",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/MeanReversionParams"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "title": "Start"
        },
        "strategy": {
          "const": "mean_reversion",
          "title": "Strategy",
          "type": "string"
        },
        "sweep": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "number"
                },
                "maxItems": 200,
                "minItems": 1,
                "type": "array"
              },
              "maxProperties": 3,
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sweep"
        }
      },
      "required": [
        "params",
        "interval",
        "start",
        "end",
        "costs",
        "seed",
        "strategy",
        "instrument_ids"
      ],
      "title": "MeanReversionRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Envelope carrying ``backtest.job/v1`` on ``backtest-jobs``.",
  "properties": {
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "message_id": {
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/BacktestJob"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9-]+@\\S+$",
      "title": "Producer",
      "type": "string"
    },
    "schema": {
      "const": "backtest.job/v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "message_id",
    "correlation_id",
    "produced_at",
    "producer",
    "schema",
    "payload"
  ],
  "title": "BacktestJobMessage",
  "type": "object"
}
