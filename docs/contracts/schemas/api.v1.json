{
  "$defs": {
    "AssetClass": {
      "description": "Asset class.",
      "enum": [
        "crude",
        "gas",
        "power",
        "fx",
        "refined"
      ],
      "title": "AssetClass",
      "type": "string"
    },
    "BacktestAccepted": {
      "additionalProperties": false,
      "description": "``202`` body of ``POST /v1/backtests``.",
      "properties": {
        "job_id": {
          "pattern": "^bt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Job Id",
          "type": "string"
        },
        "status": {
          "const": "queued",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "status"
      ],
      "title": "BacktestAccepted",
      "type": "object"
    },
    "BacktestChildren": {
      "additionalProperties": false,
      "description": "Child job counters.",
      "properties": {
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "succeeded",
        "failed"
      ],
      "title": "BacktestChildren",
      "type": "object"
    },
    "BacktestCosts": {
      "additionalProperties": false,
      "description": "Transaction costs applied to traded notional.",
      "properties": {
        "fee_bps": {
          "minimum": 0,
          "title": "Fee Bps",
          "type": "number"
        },
        "slippage_bps": {
          "minimum": 0,
          "title": "Slippage Bps",
          "type": "number"
        }
      },
      "required": [
        "fee_bps",
        "slippage_bps"
      ],
      "title": "BacktestCosts",
      "type": "object"
    },
    "BacktestList": {
      "additionalProperties": false,
      "description": "``GET /v1/backtests`` (own jobs).",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/BacktestStatus"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "title": "BacktestList",
      "type": "object"
    },
    "BacktestMetrics": {
      "additionalProperties": false,
      "description": "Metrics per SPEC-05 §3; a value without mathematical definition is ``null``.",
      "properties": {
        "ann_vol": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ann Vol"
        },
        "cagr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cagr"
        },
        "hit_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hit Rate"
        },
        "max_drawdown": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Drawdown"
        },
        "n_trades": {
          "minimum": 0,
          "title": "N Trades",
          "type": "integer"
        },
        "sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sharpe"
        },
        "turnover": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turnover"
        }
      },
      "required": [
        "cagr",
        "ann_vol",
        "sharpe",
        "max_drawdown",
        "hit_rate",
        "turnover",
        "n_trades"
      ],
      "title": "BacktestMetrics",
      "type": "object"
    },
    "BacktestRequest": {
      "description": "``POST /v1/backtests``; ``sweep`` fans out into the cartesian product of its values.",
      "discriminator": {
        "mapping": {
          "calendar_spread": "#/$defs/CalendarSpreadRequest",
          "ma_crossover": "#/$defs/MaCrossoverRequest",
          "mean_reversion": "#/$defs/MeanReversionRequest"
        },
        "propertyName": "strategy"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MaCrossoverRequest"
        },
        {
          "$ref": "#/$defs/MeanReversionRequest"
        },
        {
          "$ref": "#/$defs/CalendarSpreadRequest"
        }
      ],
      "title": "BacktestRequest"
    },
    "BacktestRequestBase": {
      "additionalProperties": false,
      "description": "Fields shared by every strategy request; subclasses add ``strategy``, ids and ``params``.",
      "properties": {
        "costs": {
          "$ref": "#/$defs/BacktestCosts"
        },
        "end": {
          "maxLength": 35,
          "pattern": "^([0-9]{1,19}|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z)$",
          "title": "End",
          "type": "string"
        },
        "interval": {
          "enum": [
            "1m",
            "1h",
            "1d"
          ],
          "title": "Interval",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "start": {
          "maxLength": 35,
          "pattern": "^([0-9]{1,19}|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z)$",
          "title": "Start",
          "type": "string"
        },
        "sweep": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "maxItems": 200,
            "minItems": 1,
            "type": "array"
          },
          "default": null,
          "maxProperties": 3,
          "minProperties": 1,
          "title": "Sweep",
          "type": "object"
        }
      },
      "required": [
        "interval",
        "start",
        "end",
        "costs",
        "seed"
      ],
      "title": "BacktestRequestBase",
      "type": "object"
    },
    "BacktestResult": {
      "additionalProperties": false,
      "description": "Result of a finished backtest.",
      "properties": {
        "equity_url": {
          "title": "Equity Url",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/BacktestMetrics"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "trades_url": {
          "title": "Trades Url",
          "type": "string"
        }
      },
      "required": [
        "metrics",
        "equity_url",
        "trades_url",
        "result_sha256"
      ],
      "title": "BacktestResult",
      "type": "object"
    },
    "BacktestStatus": {
      "additionalProperties": false,
      "description": "``GET /v1/backtests/{job_id}``.",
      "properties": {
        "children": {
          "$ref": "#/$defs/BacktestChildren"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "job_id": {
          "pattern": "^bt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Job Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacktestResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "status",
        "children",
        "submitted_at",
        "finished_at",
        "result"
      ],
      "title": "BacktestStatus",
      "type": "object"
    },
    "Bar": {
      "additionalProperties": false,
      "description": "One OHLCV bar; ``volume`` is ``null`` when the source has none (data-contracts §3.1).",
      "properties": {
        "close": {
          "title": "Close",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "open": {
          "title": "Open",
          "type": "number"
        },
        "quality": {
          "maximum": 31,
          "minimum": 0,
          "title": "Quality",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "ts_ns": {
          "title": "Ts Ns",
          "type": "integer"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "volume": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Volume"
        }
      },
      "required": [
        "ts",
        "ts_ns",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "quality",
        "version"
      ],
      "title": "Bar",
      "type": "object"
    },
    "BarsResponse": {
      "additionalProperties": false,
      "description": "``GET /v1/bars``.",
      "properties": {
        "instrument_id": {
          "maxLength": 64,
          "pattern": "^[A-Z0-9]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+$",
          "title": "Instrument Id",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Bar"
          },
          "title": "Rows",
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "instrument_id",
        "interval",
        "tier",
        "rows",
        "next_cursor"
      ],
      "title": "BarsResponse",
      "type": "object"
    },
    "CalendarSpreadRequest": {
      "additionalProperties": false,
      "description": "``calendar_spread`` on ``instrument_ids[0] - instrument_ids[1]`` (e.g. WTI FUT1 - FUT2).",
      "properties": {
        "costs": {
          "$ref": "#/$defs/BacktestCosts"
        },
        "end": {
          "maxLength": 35,
          "pattern": "^([0-9]{1,19}|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z)$",
          "title": "End",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 64,
            "pattern": "^[A-Z0-9]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Instrument Ids",
          "type": "array"
        },
        "interval": {
          "enum": [
            "1m",
            "1h",
            "1d"
          ],
          "title": "Interval",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/MeanReversionParams"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "start": {
          "maxLength": 35,
          "pattern": "^([0-9]{1,19}|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z)$",
          "title": "Start",
          "type": "string"
        },
        "strategy": {
          "const": "calendar_spread",
          "title": "Strategy",
          "type": "string"
        },
        "sweep": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "maxItems": 200,
            "minItems": 1,
            "type": "array"
          },
          "default": null,
          "maxProperties": 3,
          "minProperties": 1,
          "title": "Sweep",
          "type": "object"
        }
      },
      "required": [
        "interval",
        "start",
        "end",
        "costs",
        "seed",
        "strategy",
        "instrument_ids",
        "params"
      ],
      "title": "CalendarSpreadRequest",
      "type": "object"
    },
    "Granularity": {
      "description": "Native granularity of an instrument.",
      "enum": [
        "tick",
        "1s",
        "1m",
        "1h",
        "1d"
      ],
      "title": "Granularity",
      "type": "string"
    },
    "HealthStatus": {
      "additionalProperties": false,
      "description": "Body of ``/v1/health/live`` (``ok``) and ``/v1/health/ready`` (``ready``/``not_ready``).",
      "properties": {
        "status": {
          "enum": [
            "ok",
            "ready",
            "not_ready"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "HealthStatus",
      "type": "object"
    },
    "Instrument": {
      "additionalProperties": false,
      "description": "Instrument reference data (data-contracts §1); also the API ``Instrument`` schema.",
      "properties": {
        "asset_class": {
          "$ref": "#/$defs/AssetClass"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "description": {
          "maxLength": 256,
          "title": "Description",
          "type": "string"
        },
        "exchange_tz": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Exchange Tz",
          "type": "string"
        },
        "first_ts_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Ts Ns"
        },
        "granularity": {
          "$ref": "#/$defs/Granularity"
        },
        "instrument_id": {
          "maxLength": 64,
          "pattern": "^[A-Z0-9]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+$",
          "title": "Instrument Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/InstrumentKind"
        },
        "last_ts_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Ts Ns"
        },
        "roll_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/RollMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "unit": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "source",
        "asset_class",
        "kind",
        "unit",
        "currency",
        "exchange_tz",
        "granularity",
        "description"
      ],
      "title": "Instrument",
      "type": "object"
    },
    "InstrumentKind": {
      "description": "Instrument kind.",
      "enum": [
        "spot",
        "future",
        "continuous",
        "fx"
      ],
      "title": "InstrumentKind",
      "type": "string"
    },
    "InstrumentList": {
      "additionalProperties": false,
      "description": "``GET /v1/instruments``.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Instrument"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "InstrumentList",
      "type": "object"
    },
    "Interval": {
      "description": "Bar interval (data-contracts §3).",
      "enum": [
        "1s",
        "1m",
        "1h",
        "1d"
      ],
      "title": "Interval",
      "type": "string"
    },
    "JobStatus": {
      "description": "Backtest job status (openapi ``BacktestJobState``, ``ops.backtest_job.status``).",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "partial"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "LatestBar": {
      "additionalProperties": false,
      "description": "Last bar of one instrument.",
      "properties": {
        "bar": {
          "$ref": "#/$defs/Bar"
        },
        "instrument_id": {
          "maxLength": 64,
          "pattern": "^[A-Z0-9]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+$",
          "title": "Instrument Id",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        }
      },
      "required": [
        "instrument_id",
        "interval",
        "bar"
      ],
      "title": "LatestBar",
      "type": "object"
    },
    "LatestResponse": {
      "additionalProperties": false,
      "description": "``GET /v1/latest`` (hot store only).",
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/LatestBar"
          },
          "title": "Rows",
          "type": "array"
        },
        "tier": {
          "const": "hot",
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "tier",
        "rows"
      ],
      "title": "LatestResponse",
      "type": "object"
    },
    "MaCrossoverParams": {
      "additionalProperties": false,
      "description": "``ma_crossover`` parameters (SPEC-05 §2).",
      "properties": {
        "fast": {
          "minimum": 1,
          "title": "Fast",
          "type": "integer"
        },
        "slow": {
          "minimum": 1,
          "title": "Slow",
          "type": "integer"
        }
      },
      "required": [
        "fast",
        "slow"
      ],
      "title": "MaCrossoverParams",
      "type": "object"
    },
    "MaCrossoverRequest": {
      "additionalProperties": false,
      "description": "``ma_crossover`` on one instrument.",
      "properties": {
        "costs": {
          "$ref": "#/$defs/BacktestCosts"
        },
        "end": {
          "maxLength": 35,
          "pattern": "^([0-9]{1,19}|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z)$",
          "title": "End",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 64,
            "pattern": "^[A-Z0-9]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+$",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "interval": {
          "enum": [
            "1m",
            "1h",
            "1d"
          ],
          "title": "Interval",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/MaCrossoverParams"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "start": {
          "maxLength": 35,
          "pattern": "^([0-9]{1,19}|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z)$",
          "title": "Start",
          "type": "string"
        },
        "strategy": {
          "const": "ma_crossover",
          "title": "Strategy",
          "type": "string"
        },
        "sweep": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "maxItems": 200,
            "minItems": 1,
            "type": "array"
          },
          "default": null,
          "maxProperties": 3,
          "minProperties": 1,
          "title": "Sweep",
          "type": "object"
        }
      },
      "required": [
        "interval",
        "start",
        "end",
        "costs",
        "seed",
        "strategy",
        "instrument_ids",
        "params"
      ],
      "title": "MaCrossoverRequest",
      "type": "object"
    },
    "MeanReversionParams": {
      "additionalProperties": false,
      "description": "``mean_reversion`` / ``calendar_spread`` parameters (SPEC-05 §2).",
      "properties": {
        "lookback": {
          "minimum": 2,
          "title": "Lookback",
          "type": "integer"
        },
        "z_entry": {
          "exclusiveMinimum": 0,
          "title": "Z Entry",
          "type": "number"
        },
        "z_exit": {
          "minimum": 0,
          "title": "Z Exit",
          "type": "number"
        }
      },
      "required": [
        "lookback",
        "z_entry",
        "z_exit"
      ],
      "title": "MeanReversionParams",
      "type": "object"
    },
    "MeanReversionRequest": {
      "additionalProperties": false,
      "description": "``mean_reversion`` on one instrument.",
      "properties": {
        "costs": {
          "$ref": "#/$defs/BacktestCosts"
        },
        "end": {
          "maxLength": 35,
          "pattern": "^([0-9]{1,19}|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z)$",
          "title": "End",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 64,
            "pattern": "^[A-Z0-9]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+$",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "interval": {
          "enum": [
            "1m",
            "1h",
            "1d"
          ],
          "title": "Interval",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/MeanReversionParams"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "start": {
          "maxLength": 35,
          "pattern": "^([0-9]{1,19}|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z)$",
          "title": "Start",
          "type": "string"
        },
        "strategy": {
          "const": "mean_reversion",
          "title": "Strategy",
          "type": "string"
        },
        "sweep": {
          "additionalProperties": {
